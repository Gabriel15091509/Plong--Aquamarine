# Dépendances
node_modules/
frontend/node_modules/
backend/*/node_modules/

# Build
frontend/dist/

# Variables d'environnement
frontend/.env
backend/*/.env

# Secrets Kubernetes (générés localement à partir de k8s/secret.example.yaml)
k8s/secret.yaml

# Logs (générés localement à l'exécution, ne doivent pas être suivis)
backend/*/logs/
backend/*/*.log
frontend/*.log
*.log

# Données de langue OCR (tesseract.js) : téléchargées/mises en cache
# automatiquement à la première analyse de photo de certificat, pas du code.
backend/*/*.traineddata

# État local du CLI Netlify (lien vers le site, cache de déploiement) —
# généré par `netlify deploy`, jamais à committer.
.netlify/

# Sorties locales de Playwright (npx playwright test) : captures d'écran,
# traces, rapport HTML et état de la dernière exécution — régénérés à
# chaque run, jamais à committer.
test-results/
playwright-report/
