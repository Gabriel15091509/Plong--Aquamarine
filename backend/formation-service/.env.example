# Serveur
PORT=5010
NODE_ENV=development

# Base de données (même instance Postgres que les autres services, schéma dédié)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=plongee_db
DB_USER=postgres
DB_PASSWORD=change_me
DB_SCHEMA=formation

# JWT (doit être IDENTIQUE au secret utilisé par identite-service — sinon la
# vérification échoue partout)
JWT_SECRET=change_me

# Services externes appelés par ce service
IDENTITE_SERVICE_URL=http://localhost:5014/api
PAIEMENT_SERVICE_URL=http://localhost:5012/api

# Email (paiement de formation confirmé par mail)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=change_me
EMAIL_PASSWORD=change_me
EMAIL_FROM=Club de Plongée <no-reply@club-plongee.fr>
