# Serveur
PORT=5015
NODE_ENV=development

# Base de données (même instance Postgres que les autres services, schéma dédié)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=plongee_db
DB_USER=postgres
DB_PASSWORD=change_me
DB_SCHEMA=activites

# JWT (doit être IDENTIQUE au secret utilisé par identite-service — sinon la
# vérification échoue partout)
JWT_SECRET=change_me

# Services externes appelés par ce service
IDENTITE_SERVICE_URL=http://localhost:5014/api
MATERIEL_SERVICE_URL=http://localhost:5011
FINANCE_SERVICE_URL=http://localhost:5012
VIE_ASSOCIATIVE_SERVICE_URL=http://localhost:5013
FORMATION_SERVICE_URL=http://localhost:5010

# Email (confirmation/paiement d'inscription, promotion liste d'attente)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=change_me
EMAIL_PASSWORD=change_me
EMAIL_FROM=Club de Plongée <no-reply@club-plongee.fr>
