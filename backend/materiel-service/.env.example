# Serveur
PORT=5011
NODE_ENV=development

# Base de données (même instance Postgres que les autres services, schéma dédié)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=plongee_db
DB_USER=postgres
DB_PASSWORD=change_me
DB_SCHEMA=materiel

# JWT (doit être IDENTIQUE au secret utilisé par identite-service / le monolithe
# tant qu'il émet encore les tokens — sinon la vérification échoue partout)
JWT_SECRET=change_me

# Stockage persistant des photos de matériel (Cloudflare R2, voir
# src/utils/objectStorage.js) — facultatif : si l'une de ces variables est
# absente, on retombe sur le disque local (comportement historique). En
# local, laisser vide/absent est le comportement normal ; à ne renseigner
# qu'en production (Render), où le disque local est effacé à chaque
# redéploiement.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
