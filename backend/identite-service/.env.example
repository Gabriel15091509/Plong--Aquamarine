# Serveur
PORT=5014
NODE_ENV=development

# Base de données (même instance Postgres que les autres services, schéma dédié)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=plongee_db
DB_USER=postgres
DB_PASSWORD=change_me
DB_SCHEMA=identite

# JWT — identite-service est le seul émetteur des tokens ; tous les autres
# services doivent partager le même secret pour vérifier la signature.
JWT_SECRET=change_me
JWT_EXPIRE=7d

# Services externes appelés par ce service (pour
# AdherentService.getAdherentWithDetails / getAdherentsWithExpiringCertificates)
FINANCE_SERVICE_URL=http://localhost:5012
VIE_ASSOCIATIVE_SERVICE_URL=http://localhost:5013

# Email (bienvenue à la création de compte)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=change_me
EMAIL_PASSWORD=change_me
EMAIL_FROM=Club de Plongée <no-reply@club-plongee.fr>
