# Serveur
PORT=5013
NODE_ENV=development

# Base de données (même instance Postgres que les autres services, schéma dédié)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=plongee_db
DB_USER=postgres
DB_PASSWORD=change_me
DB_SCHEMA=vie_associative

# JWT (doit être IDENTIQUE au secret utilisé par identite-service — sinon la
# vérification échoue partout)
JWT_SECRET=change_me

# Services externes appelés par ce service
IDENTITE_SERVICE_URL=http://localhost:5014/api
FINANCE_SERVICE_URL=http://localhost:5012

# Email (paiement d'adhésion confirmé par mail)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=change_me
EMAIL_PASSWORD=change_me
EMAIL_FROM=Club de Plongée <no-reply@club-plongee.fr>

# Chiffrement des certificats médicaux au repos (exigence 4.4) — 32 octets
# en base64, ex. généré via `openssl rand -base64 32`
CERTIFICAT_ENCRYPTION_KEY=change_me

# Validation automatique (API Groq, gratuite) des documents soumis par un
# adhérent (licence FFESM/assurance, certificat médical) — remplace la
# validation manuelle du président/trésorier pour ce circuit quand Groq
# répond, voir AdhesionService.judgeSubmittedDocument / CertificatMedicalService.
# judgeSubmittedDocument. Clé gratuite sans carte bancaire sur
# console.groq.com. Sans clé (ou Groq injoignable) : la soumission reste
# "En attente" d'une validation manuelle, comme avant ce circuit — jamais
# rejetée automatiquement faute de réponse (voir groqClient.
# judgeDocumentCoherence).
GROQ_API_KEY=change_me
GROQ_MODEL=groq/compound-mini

# SMS de dernière minute (CDC 3.6.1), via l'API OVH SMS (HTTP2SMS) — compte
# à créer sur le manager OVH (SMS > créer un compte). Sans ces identifiants,
# l'envoi est simulé (loggé, jamais réellement envoyé) plutôt que de faire
# échouer la relance — voir utils/smsClient.js.
OVH_SMS_ACCOUNT=change_me
OVH_SMS_LOGIN=change_me
OVH_SMS_PASSWORD=change_me
OVH_SMS_FROM=Aquanature

# Stockage persistant des documents d'adhésion (publics) et certificats
# médicaux (chiffrés, jamais servis en direct) — Cloudflare R2, voir
# src/utils/objectStorage.js. Facultatif : si l'une de ces variables est
# absente, on retombe sur le disque local (comportement historique). En
# local, laisser vide/absent est le comportement normal ; à ne renseigner
# qu'en production (Render), où le disque local est effacé à chaque
# redéploiement.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
