# Serveur
PORT=5012
NODE_ENV=development

# Base de données (même instance Postgres que les autres services, schéma dédié)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=plongee_db
DB_USER=postgres
DB_PASSWORD=change_me
DB_SCHEMA=finance

# JWT (doit être IDENTIQUE au secret utilisé par identite-service — sinon la
# vérification échoue partout)
JWT_SECRET=change_me

# Services externes appelés par ce service
IDENTITE_SERVICE_URL=http://localhost:5014/api
ADHESION_SERVICE_URL=http://localhost:5013
INSCRIPTION_SERVICE_URL=http://localhost:5015
FORMATION_SERVICE_URL=http://localhost:5010
