# Les services applicatifs passent par PgBouncer (k8s/base/13-pgbouncer.yaml),
# pas directement par postgres — nécessaire dès que le HPA multiplie les
# réplicas Node (voir le commentaire de 13-pgbouncer.yaml). PgBouncer,
# lui, cible directement "postgres" en amont (configuré en dur dans son
# propre manifest, indépendant de cette valeur).
DB_HOST=pgbouncer
DB_PORT=5432
DB_NAME=plongee_db
DB_USER=postgres
NODE_ENV=production
# DNS interne k8s (namespace plongee-app) — au format court, résolu par
# CoreDNS sans avoir besoin du nom pleinement qualifié.
FORMATION_SERVICE_URL=http://formation-service:5010
MATERIEL_SERVICE_URL=http://materiel-service:5011
FINANCE_SERVICE_URL=http://finance-service:5012
VIE_ASSOCIATIVE_SERVICE_URL=http://vie-associative-service:5013
IDENTITE_SERVICE_URL=http://identite-service:5014/api
ACTIVITES_SERVICE_URL=http://activites-service:5015
PAIEMENT_SERVICE_URL=http://finance-service:5012/api
ADHESION_SERVICE_URL=http://vie-associative-service:5013
INSCRIPTION_SERVICE_URL=http://activites-service:5015
# Coupure temporaire du 2FA du président (2026-08-13, demande explicite du
# président lui-même) — voir le commentaire dans AuthController.login().
# À repasser à "false" (ou retirer la ligne) dès que possible : tant que
# c'est "true", le compte le plus privilégié du site (accessible sur
# internet) n'a plus que le mot de passe comme protection.
PRESIDENT_2FA_DISABLED=true
